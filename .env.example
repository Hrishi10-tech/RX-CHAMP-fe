
# Where /api/* is proxied (server-only — must NOT be NEXT_PUBLIC_, so the browser
# keeps using relative URLs and goes through the Next rewrite).
# Local: http://localhost:4000   Deployed: https://rx-champ-be-production.up.railway.app
BACKEND_URL=http://localhost:4000

# Socket origin. The browser connects here directly, so it must be reachable from
# the user's machine — a proxy cannot cover it.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
