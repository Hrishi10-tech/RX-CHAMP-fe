
BACKEND_URL=http://localhost:4000


# Where the browser opens socket.io. May name the backend host directly, even on
# a different domain from the app: the handshake authenticates off a short-lived
# ticket fetched over the proxied API, not off the auth cookie. That cookie is
# issued through the `/api/*` proxy, so it belongs to this app's own origin and
# the browser never sends it to another host.
#
# Empty means same-origin, which needs a websocket proxy forwarding /socket.io to
# BACKEND_URL — a rewrites() entry does not upgrade websockets.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
